#include <GL/glut.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

static float camX = 0.0f, camY = 0.0f, camZ = 5.0f;
static float yaw   = 0.0f;
static float pitch = 0.0f;
static float fov   = 60.0f;

static int   mouseDown = 0;
static int   lastMouseX = 0, lastMouseY = 0;
static int   wireframe = 0;
static int   autoRotate = 0;
static float autoAngle = 0.0f;

static float cubeSize = 1.0f;

static const float faceNormals[6][3] = {
    {  0,  0,  1},
    {  0,  0, -1},
    { -1,  0,  0},
    {  1,  0,  0},
    {  0,  1,  0},
    {  0, -1,  0}
};

static const float faceColors[6][3] = {
    {1.00f, 0.20f, 0.25f},
    {0.20f, 0.60f, 1.00f},
    {1.00f, 0.55f, 0.10f},
    {0.15f, 0.85f, 0.45f},
    {1.00f, 0.90f, 0.20f},
    {0.75f, 0.30f, 1.00f}
};

static void applyCamera(void)
{
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluPerspective(fov, (float)glutGet(GLUT_WINDOW_WIDTH) /
                        (float)glutGet(GLUT_WINDOW_HEIGHT), 0.1, 100.0);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();

    glRotatef(-pitch * 180.0f / (float)M_PI, 1.0f, 0.0f, 0.0f);
    glRotatef(-yaw   * 180.0f / (float)M_PI, 0.0f, 1.0f, 0.0f);
    glTranslatef(-camX, -camY, -camZ);
}

static void drawFace(int face, float s)
{
    static const float verts[6][4][3] = {
        {{-s,-s, s}, { s,-s, s}, { s, s, s}, {-s, s, s}},
        {{ s,-s,-s}, {-s,-s,-s}, {-s, s,-s}, { s, s,-s}},
        {{-s,-s,-s}, {-s,-s, s}, {-s, s, s}, {-s, s,-s}},
        {{ s,-s, s}, { s,-s,-s}, { s, s,-s}, { s, s, s}},
        {{-s, s, s}, { s, s, s}, { s, s,-s}, {-s, s,-s}},
        {{-s,-s,-s}, { s,-s,-s}, { s,-s, s}, {-s,-s, s}}
    };

    glBegin(GL_QUADS);
        glNormal3fv(faceNormals[face]);
        glColor3fv(faceColors[face]);
        for (int i = 0; i < 4; ++i)
            glVertex3fv(verts[face][i]);
    glEnd();

    if (!wireframe) {
        glDisable(GL_LIGHTING);
        glColor3f(0.05f, 0.05f, 0.08f);
        glLineWidth(1.5f);
        glBegin(GL_LINE_LOOP);
            for (int i = 0; i < 4; ++i)
                glVertex3fv(verts[face][i]);
        glEnd();
        glEnable(GL_LIGHTING);
    }
}

static void display(void)
{
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    applyCamera();

    glPushMatrix();

    if (autoRotate) {
        glRotatef(autoAngle, 0.3f, 1.0f, 0.2f);
    } else {
        glRotatef(autoAngle * 0.3f, 0.0f, 1.0f, 0.0f);
    }

    if (wireframe) {
        glDisable(GL_LIGHTING);
        glPolygonMode(GL_FRONT_AND_BACK, GL_LINE);
        glLineWidth(2.0f);
        for (int i = 0; i < 6; ++i) {
            glColor3fv(faceColors[i]);
            glBegin(GL_QUADS);
            glNormal3fv(faceNormals[i]);
            float s = cubeSize;
            static const float verts[6][4][3] = {
                {{-s,-s, s}, { s,-s, s}, { s, s, s}, {-s, s, s}},
                {{ s,-s,-s}, {-s,-s,-s}, {-s, s,-s}, { s, s,-s}},
                {{-s,-s,-s}, {-s,-s, s}, {-s, s, s}, {-s, s,-s}},
                {{ s,-s, s}, { s,-s,-s}, { s, s,-s}, { s, s, s}},
                {{-s, s, s}, { s, s, s}, { s, s,-s}, {-s, s,-s}},
                {{-s,-s,-s}, { s,-s,-s}, { s,-s, s}, {-s,-s, s}}
            };
            for (int v = 0; v < 4; ++v) glVertex3fv(verts[i][v]);
            glEnd();
        }
        glPolygonMode(GL_FRONT_AND_BACK, GL_FILL);
        glEnable(GL_LIGHTING);
    } else {
        for (int i = 0; i < 6; ++i)
            drawFace(i, cubeSize);
    }

    glPopMatrix();

    glMatrixMode(GL_PROJECTION);
    glPushMatrix();
    glLoadIdentity();
    gluOrtho2D(0, glutGet(GLUT_WINDOW_WIDTH),
               0, glutGet(GLUT_WINDOW_HEIGHT));
    glMatrixMode(GL_MODELVIEW);
    glPushMatrix();
    glLoadIdentity();
    glDisable(GL_LIGHTING);
    glColor3f(0.85f, 0.90f, 1.0f);
    glRasterPos2i(12, glutGet(GLUT_WINDOW_HEIGHT) - 20);
    const char *help = "WASD move | Q/E up/down | Arrows look | Drag rotate | Wheel zoom | R reset | F wire | Space auto";
    for (const char *c = help; *c; ++c)
        glutBitmapCharacter(GLUT_BITMAP_8_BY_13, *c);
    glEnable(GL_LIGHTING);
    glPopMatrix();
    glMatrixMode(GL_PROJECTION);
    glPopMatrix();
    glMatrixMode(GL_MODELVIEW);

    glutSwapBuffers();
}

static void keyboard(unsigned char key, int x, int y)
{
    (void)x; (void)y;
    const float moveStep = 0.25f;
    float dx = cosf(yaw) * moveStep;
    float dz = -sinf(yaw) * moveStep;

    switch (key) {
    case 27: exit(0); break;
    case 'w': case 'W': camX += dx; camZ += dz; break;
    case 's': case 'S': camX -= dx; camZ -= dz; break;
    case 'a': case 'A': camX -= dz; camZ += dx; break;
    case 'd': case 'D': camX += dz; camZ -= dx; break;
    case 'q': case 'Q': camY += moveStep; break;
    case 'e': case 'E': camY -= moveStep; break;
    case 'r': case 'R':
        camX = 0; camY = 0; camZ = 5;
        yaw = 0; pitch = 0; fov = 60;
        autoAngle = 0;
        break;
    case 'f': case 'F': wireframe = !wireframe; break;
    case ' ': autoRotate = !autoRotate; break;
    }
    glutPostRedisplay();
}

static void special(int key, int x, int y)
{
    (void)x; (void)y;
    const float rotStep = 0.05f;
    switch (key) {
    case GLUT_KEY_LEFT:  yaw   -= rotStep; break;
    case GLUT_KEY_RIGHT: yaw   += rotStep; break;
    case GLUT_KEY_UP:    pitch -= rotStep; break;
    case GLUT_KEY_DOWN:  pitch += rotStep; break;
    }
    if (pitch >  1.5f) pitch =  1.5f;
    if (pitch < -1.5f) pitch = -1.5f;
    glutPostRedisplay();
}

static void mouse(int button, int state, int x, int y)
{
    if (button == GLUT_LEFT_BUTTON) {
        mouseDown = (state == GLUT_DOWN);
        lastMouseX = x; lastMouseY = y;
    } else if (button == 3) {
        fov -= 2.0f; if (fov < 15.0f) fov = 15.0f;
        glutPostRedisplay();
    } else if (button == 4) {
        fov += 2.0f; if (fov > 120.0f) fov = 120.0f;
        glutPostRedisplay();
    }
}

static void motion(int x, int y)
{
    if (!mouseDown) return;
    float dx = (float)(x - lastMouseX) * 0.008f;
    float dy = (float)(y - lastMouseY) * 0.008f;
    yaw   += dx;
    pitch += dy;
    if (pitch >  1.5f) pitch =  1.5f;
    if (pitch < -1.5f) pitch = -1.5f;
    lastMouseX = x; lastMouseY = y;
    glutPostRedisplay();
}

static void idle(void)
{
    autoAngle += 0.5f;
    if (autoAngle > 360.0f) autoAngle -= 360.0f;
    if (autoRotate) glutPostRedisplay();
}

static void reshape(int w, int h)
{
    if (h == 0) h = 1;
    glViewport(0, 0, w, h);
}

static void init(void)
{
    glClearColor(0.05f, 0.06f, 0.10f, 1.0f);
    glEnable(GL_DEPTH_TEST);
    glEnable(GL_CULL_FACE);
    glCullFace(GL_BACK);
    glShadeModel(GL_SMOOTH);

    glEnable(GL_LIGHTING);
    glEnable(GL_LIGHT0);
    glEnable(GL_COLOR_MATERIAL);
    glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

    GLfloat lightPos[]    = { 4.0f, 6.0f, 5.0f, 1.0f };
    GLfloat lightDiffuse[] = { 1.0f, 1.0f, 1.0f, 1.0f };
    GLfloat lightSpecular[]= { 1.0f, 1.0f, 1.0f, 1.0f };
    GLfloat ambient[]      = { 0.30f, 0.30f, 0.35f, 1.0f };
    GLfloat shininess[]    = { 64.0f };

    glLightfv(GL_LIGHT0, GL_POSITION, lightPos);
    glLightfv(GL_LIGHT0, GL_DIFFUSE,  lightDiffuse);
    glLightfv(GL_LIGHT0, GL_SPECULAR, lightSpecular);
    glLightfv(GL_LIGHT0, GL_AMBIENT,  ambient);

    glMaterialfv(GL_FRONT_AND_BACK, GL_SHININESS, shininess);

    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glEnable(GL_LINE_SMOOTH);
    glHint(GL_LINE_SMOOTH_HINT, GL_NICEST);
    glEnable(GL_MULTISAMPLE);
}

int main(int argc, char **argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH | GLUT_MULTISAMPLE);
    glutInitWindowSize(900, 700);
    glutInitWindowPosition(80, 60);
    glutCreateWindow("3D Color Cube - Interactive Perspective Viewer");

    init();

    glutDisplayFunc(display);
    glutReshapeFunc(reshape);
    glutKeyboardFunc(keyboard);
    glutSpecialFunc(special);
    glutMouseFunc(mouse);
    glutMotionFunc(motion);
    glutIdleFunc(idle);

    printf("=== 3D Color Cube Viewer ===\n");
    printf("W/A/S/D    - move camera\n");
    printf("Q/E        - up / down\n");
    printf("Arrow keys - look around\n");
    printf("Mouse drag - rotate camera\n");
    printf("Mouse wheel- zoom (FOV)\n");
    printf("R          - reset camera\n");
    printf("F          - wireframe toggle\n");
    printf("Space      - auto-rotation toggle\n");
    printf("ESC        - quit\n");

    glutMainLoop();
    return 0;
}
